name = "888wiki"
main = "src/index.js"
compatibility_date = "2024-12-01"
compatibility_flags = ["nodejs_compat"]

kv_namespaces = [
	{ binding = "NOTES", id = "demo" },
	{ binding = "SHARE", id = "demo" }
]

[assets]
directory = "./static"

[vars]
SCN_STORAGE_DRIVER = "auto"
SCN_APP_NAME = "888wiki"
SCN_ADMIN_PATH = "/admin"
SCN_SLUG_LENGTH = "4"
SCN_ENABLE_R2 = "1"
SCN_R2_DOMAIN = ""
SCN_GA_MEASUREMENT_ID = ""
SCN_ENABLE_WEBTALK = "0"
SCN_WEBTALK_SCRIPT_URL = ""
SCN_WEBTALK_AI_ENDPOINT = ""
SCN_WEBTALK_SCOPE = "meta"
SCN_WEBTALK_SITE_ID = ""
SCN_ENABLE_NOTE_HISTORY = "1"
SCN_NOTE_HISTORY_LIMIT = "10"
SCN_NOTE_HISTORY_MIN_INTERVAL_SECONDS = "300"

[secrets]
required = ["SCN_SALT", "SCN_SECRET", "SCN_ADMIN_PW"]

[[r2_buckets]]
binding = "IMAGES"
bucket_name = "888wiki-images"

[[d1_databases]]
binding = "NOTE_HISTORY_DB"
database_name = "888wiki-history"
database_id = "demo"
# The same D1 binding can store note history, share view counts, and annotations.
# Apply schema/note_history.sql, schema/note_stats.sql, and schema/note_annotations.sql as needed.

# Cron trigger: Daily cleanup at 9 AM Taiwan time (1 AM UTC)
[triggers]
crons = ["0 1 * * *"]
