{
  "name": "serverless-cloud-notepad",
  "version": "1.0.0",
  "author": "s0urce",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.1",
    "wrangler": "^4.86.0"
  },
  "private": true,
  "scripts": {
    "build:block-editor": "node scripts/build-block-editor.mjs",
    "prepare:skill-doc": "node scripts/generate-agent-skill.mjs",
    "prestart": "npm run prepare:skill-doc",
    "start": "wrangler dev",
    "predev": "npm run prepare:skill-doc",
    "dev": "wrangler dev",
    "predeploy": "npm run prepare:skill-doc && npm run build:block-editor",
    "deploy": "wrangler deploy",
    "prepublish": "npm run prepare:skill-doc",
    "publish": "wrangler deploy",
    "pretest": "npm run prepare:skill-doc && npm run build:block-editor",
    "test": "node --test test/**/*.test.mjs"
  },
  "dependencies": {
    "@blocknote/core": "^0.53.0",
    "@blocknote/mantine": "^0.53.0",
    "@blocknote/react": "^0.53.0",
    "@firecrawl/anydoc-wasm": "^0.1.6",
    "@mantine/core": "^9.5.1",
    "@mantine/hooks": "^9.5.1",
    "@mantine/utils": "^6.0.22",
    "@tsndr/cloudflare-worker-jwt": "^1.1.7",
    "cookie": "^0.5.0",
    "dayjs": "^1.11.2",
    "itty-router": "^2.6.1",
    "jsdom": "^29.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
